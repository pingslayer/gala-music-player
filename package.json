{
  "name": "gala-music-player",
  "version": "1.0.0",
  "description": "An ultra-robust, native Apple Music client for Linux powered by CastLabs Electron.",
  "main": "src/main/index.js",
  "author": "Ronald",
  "homepage": "https://github.com/pingslayer/gala-music-player",
  "repository": {
    "type": "git",
    "url": "https://github.com/pingslayer/gala-music-player.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "mpris-service": "^2.1.2"
  },
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v44.1.0+wvcus",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.gala.music",
    "productName": "Gala Music Player",
    "icon": "assets/icon.png",
    "directories": {
      "output": "dist"
    },
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Audio",
      "executableName": "gala-music-player",
      "desktop": {
        "entry": {
          "Actions": "PlayPause;Next;Previous;"
        },
        "desktopActions": {
          "PlayPause": {
            "Name": "Play / Pause",
            "Exec": "dbus-send --print-reply --dest=org.mpris.MediaPlayer2.gala /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.PlayPause"
          },
          "Next": {
            "Name": "Next Track",
            "Exec": "dbus-send --print-reply --dest=org.mpris.MediaPlayer2.gala /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Next"
          },
          "Previous": {
            "Name": "Previous Track",
            "Exec": "dbus-send --print-reply --dest=org.mpris.MediaPlayer2.gala /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Previous"
          }
        }
      }
    }
  }
}
